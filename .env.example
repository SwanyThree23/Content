# ============================================
# AI SOAP OPERA STUDIO - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your actual values

# ============================================
# DATABASE (Railway PostgreSQL)
# ============================================
DATABASE_URL="postgresql://user:password@your-railway-host:5432/railway"
DIRECT_URL="postgresql://user:password@your-railway-host:5432/railway"

# ============================================
# AI SERVICES
# ============================================
# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-your-key-here"
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# Google Veo 3 (Vertex AI)
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
VEO_MODEL="imagen-3.0-generate-001"

# ============================================
# YOUTUBE INTEGRATION
# ============================================
YOUTUBE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-client-secret"
YOUTUBE_REDIRECT_URI="https://your-domain.vercel.app/api/auth/youtube/callback"

# Domino Entertainment Channel (Optional)
DOMINO_CHANNEL_ID="UCYourChannelID"
DOMINO_CHANNEL_NAME="Domino Entertainment"

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
API_RATE_LIMIT="100"
ENCRYPTION_KEY="your-32-character-encryption-key"

# ============================================
# NEXT.JS & DEPLOYMENT
# ============================================
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_URL="https://your-domain.vercel.app/api"
NODE_ENV="production"

# ============================================
# REDIS (Optional - for queue management)
# ============================================
REDIS_URL="redis://default:password@your-redis-host:6379"

# ============================================
# N8N AUTOMATION (Optional)
# ============================================
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/soap-opera"
N8N_API_KEY="your-n8n-api-key"

# ============================================
# CAPCUT API (Optional - for auto-editing)
# ============================================
CAPCUT_API_KEY="your-capcut-api-key"
CAPCUT_WORKSPACE_ID="your-workspace-id"

# ============================================
# MONITORING & ANALYTICS
# ============================================
SENTRY_DSN="https://your-sentry-dsn.ingest.sentry.io/project-id"
ANALYTICS_ID="G-XXXXXXXXXX"

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AUTO_PUBLISH="true"
ENABLE_VIDEO_GENERATION="true"
ENABLE_ANALYTICS="true"
ENABLE_AUTOMATION="true"

# ============================================
# COST LIMITS & QUOTAS
# ============================================
MAX_VIDEOS_PER_DAY="10"
MAX_SCENES_PER_EPISODE="8"
MAX_EPISODE_DURATION_MINUTES="5"
DAILY_BUDGET_USD="50"
